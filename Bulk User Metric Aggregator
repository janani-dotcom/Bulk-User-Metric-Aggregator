# =========================
# SERVER
# =========================

server <- function(input, output, session) {
  
  # Read CSV
  userData <- reactive({
    
    req(input$file)
    
    read.csv(
      input$file$datapath,
      stringsAsFactors = FALSE
    )
    
  })
  
  
  # Find numeric columns
  observeEvent(userData(), {
    
    df <- userData()
    
    numericColumns <- names(
      df[sapply(df, is.numeric)]
    )
    
    updateSelectInput(
      session,
      "metric",
      choices = numericColumns
    )
    
  })
  
  
  # Total Users
  output$total <- renderText({
    
    req(userData())
    
    nrow(userData())
    
  })
  
  
  # Average
  output$average <- renderText({
    
    req(input$calculate)
    req(input$metric)
    
    values <- userData()[[input$metric]]
    
    round(
      mean(values, na.rm = TRUE),
      2
    )
    
  })
  
  
  # Maximum
  output$maximum <- renderText({
    
    req(input$calculate)
    req(input$metric)
    
    values <- userData()[[input$metric]]
    
    round(
      max(values, na.rm = TRUE),
      2
    )
    
  })
  
  
  # Data Table
  output$dataTable <- renderDT({
    
    req(userData())
    
    datatable(
      userData(),
      options = list(
        pageLength = 5,
        scrollX = TRUE
      )
    )
    
  })
  
  
  # Summary
  output$summary <- renderTable({
    
    req(input$calculate)
    req(input$metric)
    
    values <- userData()[[input$metric]]
    
    data.frame(
      
      Metric = c(
        "Total Records",
        "Minimum",
        "Maximum",
        "Average",
        "Median",
        "Standard Deviation"
      ),
      
      Value = c(
        length(na.omit(values)),
        round(min(values, na.rm = TRUE), 2),
        round(max(values, na.rm = TRUE), 2),
        round(mean(values, na.rm = TRUE), 2),
        round(median(values, na.rm = TRUE), 2),
        round(sd(values, na.rm = TRUE), 2)
      )
      
    )
    
  })
  
  
  # Graph
  output$graph <- renderPlot({
    
    req(input$calculate)
    req(input$metric)
    
    values <- userData()[[input$metric]]
    
    hist(
      values,
      main = paste(
        "Distribution of",
        input$metric
      ),
      xlab = input$metric,
      border = "white",
      col = "#90caf9"
    )
    
  })
  
}


# =========================
# RUN APP
# =========================

shinyApp(
